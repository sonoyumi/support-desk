# Скопируйте в .env и заполните. Сам .env в git не попадает.

# Токен бота поддержки от @BotFather (клиенты пишут этому боту)
BOT_TOKEN=
# Чат операторов (группа), куда приходят «новое обращение» и «SLA нарушен». Пусто — без уведомлений.
OPERATORS_CHAT_ID=

# Панель операторов
HOST=127.0.0.1
PORT=8096
# Случайная строка для подписи входа в панель: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Адрес панели для ссылок в уведомлениях (например https://support.example.com)
PANEL_URL=http://127.0.0.1:8096
# Cookie только по HTTPS (включите на сервере за nginx с сертификатом)
COOKIE_SECURE=false

# Хранилище
DATABASE_PATH=data/support.db

# Правила
COMPANY_NAME=Assistenza clienti
# За сколько минут нужен первый ответ оператора (SLA)
SLA_FIRST_REPLY_MINUTES=30
# Через сколько часов «Ждём клиента» закрывается само
AUTO_CLOSE_HOURS=48
# Максимальная длина сообщения клиента и ответа оператора
MAX_MESSAGE_CHARS=3500
